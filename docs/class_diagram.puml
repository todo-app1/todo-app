@startuml class_diagram

class Task {
    +title: str
    +deadline: str
    +done: bool
    +mark_done()
    +__str__()
}

class TaskManager {
    -tasks: List[Task]
    +add_task(task: Task)
    +remove_task(title: str) : bool
    +get_all() : List[Task]
    +find_by_title(title: str) : Task
}

' Абстрактный класс хранилища
class Storage <<abstract>> {
    +load() : List[Task>
    +save(tasks: List[Task>)
}

' Конкретные реализации хранилища
class FileStorage {
    -filename: str
}

class MemoryStorage {
    -_data: List[Task>
}

' Связи между классами
ConsoleUI --> TaskManager
TaskManager o-- "0..*" Task
TaskManager ..> Storage

Storage <|-- FileStorage
Storage <|-- MemoryStorage

'@enduml